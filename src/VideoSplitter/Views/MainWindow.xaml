<Window x:Class="VideoSplitter.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:vm="clr-namespace:VideoSplitter.ViewModels"
        xmlns:controls="clr-namespace:VideoSplitter.Controls"
        xmlns:conv="clr-namespace:VideoSplitter.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Style="{StaticResource DarkWindowStyle}"
        Title="{Binding Title}"
        Width="1280"
        Height="800"
        MinWidth="1000"
        MinHeight="650"
        AllowDrop="True"
        DragOver="OnWindowDragOver"
        Drop="OnWindowDrop"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:TimeSpanToStringConverter x:Key="TimeSpanConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Barre du haut -->
            <RowDefinition Height="Auto" />
            <!-- Zone lecteur (LibVLC) -->
            <RowDefinition Height="*" />
            <!-- Controles de lecture + barre de lecture -->
            <RowDefinition Height="Auto" />
            <!-- Zone timeline (~120 px) -->
            <RowDefinition Height="Auto" />
            <!-- Panneau du bas -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Barre du haut -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Ouvrir"
                            Command="{Binding Player.OuvrirCommand}"
                            Focusable="False"
                            Margin="0,0,8,0" />
                    <Button Content="Exporter"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsEnabled="False"
                            ToolTip="Disponible a l'etape 6"
                            Margin="0,0,16,0" />

                    <Border Width="1"
                            Height="20"
                            Background="{StaticResource BorderBrush}"
                            Margin="0,0,16,0" />

                    <TextBlock Text="Mode :"
                               Style="{StaticResource MutedTextStyle}"
                               Margin="0,0,10,0" />
                    <RadioButton Content="Rapide"
                                 GroupName="ExportMode"
                                 IsChecked="True"
                                 Focusable="False"
                                 Margin="0,0,12,0" />
                    <RadioButton Content="Precis"
                                 GroupName="ExportMode"
                                 Focusable="False" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding Player.MediaSummary}"
                           Style="{StaticResource MutedTextStyle}" />
            </DockPanel>
        </Border>

        <!-- 2. Zone lecteur (aucun controle superpose : contrainte airspace LibVLC/HwndHost) -->
        <Border Grid.Row="1"
                Background="{StaticResource VideoBackgroundBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1">
            <vlc:VideoView x:Name="LecteurVideoView" />
        </Border>

        <!-- 3. Controles de lecture -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="&lt; Image"
                                Command="{Binding Player.StepBackwardCommand}"
                                Focusable="False"
                                ToolTip="Image precedente (Fleche gauche)"
                                Margin="0,0,6,0" />
                        <Button Command="{Binding Player.PlayPauseCommand}"
                                Focusable="False"
                                MinWidth="92"
                                ToolTip="Lecture / Pause (Espace)"
                                Margin="0,0,6,0">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="Lecture" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Player.IsPlaying}" Value="True">
                                            <Setter Property="Content" Value="Pause" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Image &gt;"
                                Command="{Binding Player.StepForwardCommand}"
                                Focusable="False"
                                ToolTip="Image suivante (Fleche droite)"
                                Margin="0,0,16,0" />

                        <TextBlock FontFamily="Consolas"
                                   FontSize="13"
                                   Foreground="{StaticResource TextPrimaryBrush}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} / {1}">
                                    <Binding Path="Player.Position" Converter="{StaticResource TimeSpanConverter}" ConverterParameter="ms" />
                                    <Binding Path="Player.Duration" Converter="{StaticResource TimeSpanConverter}" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Command="{Binding Player.ToggleMuteCommand}"
                                Focusable="False"
                                MinWidth="58"
                                Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="Son" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Player.IsMuted}" Value="True">
                                            <Setter Property="Content" Value="Muet" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Slider Width="95"
                                Minimum="0"
                                Maximum="100"
                                Value="{Binding Player.Volume, Mode=TwoWay}"
                                Focusable="False"
                                IsEnabled="{Binding Player.IsMediaLoaded}"
                                Margin="0,0,16,0" />

                        <TextBlock Text="Vitesse :" Style="{StaticResource MutedTextStyle}" Margin="0,0,6,0" />
                        <ComboBox Width="74"
                                  ItemsSource="{Binding Player.SpeedOptions}"
                                  SelectedItem="{Binding Player.Speed, Mode=TwoWay}"
                                  IsEnabled="{Binding Player.IsMediaLoaded}"
                                  Focusable="False">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat={}{0:0.##}x}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </DockPanel>

                <controls:SeekBar Grid.Row="1"
                                  Duration="{Binding Player.Duration}"
                                  Position="{Binding Player.Position}"
                                  IsEnabled="{Binding Player.IsMediaLoaded}"
                                  SeekRequested="OnSeekBarSeekRequested" />
            </Grid>
        </Border>

        <!-- 4. Zone timeline (hauteur ~120 px, placeholder) -->
        <Border Grid.Row="3"
                Height="120"
                Background="{StaticResource WindowBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Outils :" Style="{StaticResource MutedTextStyle}" Margin="0,0,8,0" />
                    <Button Content="Split (S)" IsEnabled="False" Margin="0,0,6,0" />
                    <Button Content="In (I)" IsEnabled="False" Margin="0,0,6,0" />
                    <Button Content="Out (O)" IsEnabled="False" Margin="0,0,6,0" />
                    <Button Content="Supprimer" IsEnabled="False" Margin="0,0,12,0" />
                    <Button Content="Zoom -" IsEnabled="False" Margin="0,0,6,0" />
                    <Button Content="Zoom +" IsEnabled="False" />
                </StackPanel>

                <Border Grid.Row="1"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <TextBlock Text="Timeline d'edition (filmstrip, marqueurs et segments — etape 4)"
                               Style="{StaticResource MutedTextStyle}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- 5. Panneau du bas (placeholders) -->
        <Border Grid.Row="4"
                Height="170"
                Background="{StaticResource SurfaceBrush}"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Liste des segments -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="LISTE DES SEGMENTS" Style="{StaticResource SectionTitleStyle}" />
                    <ListView Grid.Row="1">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="#" Width="36" />
                                <GridViewColumn Header="Nom" Width="150" />
                                <GridViewColumn Header="Debut" Width="85" />
                                <GridViewColumn Header="Fin" Width="85" />
                                <GridViewColumn Header="Duree" Width="85" />
                                <GridViewColumn Header="Inclus" Width="55" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>

                <!-- Options d'export -->
                <Border Grid.Column="2"
                        Background="{StaticResource WindowBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10">
                    <StackPanel>
                        <TextBlock Text="OPTIONS D'EXPORT" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Dossier de sortie : —" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,4" />
                        <TextBlock Text="Modele : {nom}_part{NN}" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,4" />
                        <TextBlock Text="Qualite / Encodeur : Auto (CRF 18)" Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                </Border>

                <!-- Progression -->
                <Border Grid.Column="4"
                        Background="{StaticResource WindowBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="PROGRESSION" Style="{StaticResource SectionTitleStyle}" />
                        <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="0" Margin="0,4,0,6" />
                        <TextBlock Grid.Row="2" Text="En attente" Style="{StaticResource MutedTextStyle}" />
                        <Button Grid.Row="4" Content="Annuler l'export" IsEnabled="False" HorizontalAlignment="Right" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
