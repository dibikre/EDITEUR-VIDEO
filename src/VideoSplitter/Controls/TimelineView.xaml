<UserControl x:Class="VideoSplitter.Controls.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:VideoSplitter.Controls"
             mc:Ignorable="d"
             d:DesignHeight="185"
             d:DesignWidth="1100">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barre d'outils edition + zoom de la timeline -->
        <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="10,0,0,0">
                <TextBlock Text="{Binding Edit.KeyframeStatus, RelativeSource={RelativeSource AncestorType=controls:TimelineView}}"
                           Style="{StaticResource MutedTextStyle}"
                           Margin="0,0,12,0" />
                <TextBlock Text="{Binding Timeline.ZoomLabel, RelativeSource={RelativeSource AncestorType=controls:TimelineView}}"
                           Style="{StaticResource MutedTextStyle}"
                           FontFamily="Consolas" />
            </StackPanel>

            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Split (S)"
                        Command="{Binding Edit.SplitCommand, RelativeSource={RelativeSource AncestorType=controls:TimelineView}}"
                        Focusable="False"
                        Padding="8,3"
                        MinHeight="26"
                        ToolTip="Couper le segment au playhead (S)"
                        Margin="0,0,4,2" />
                <Button Content="In (I)"
                        Command="{Binding Edit.SetInCommand, RelativeSource={RelativeSource AncestorType=controls:TimelineView}}"
                        Focusable="False"
                        Padding="8,3"
                        MinHeight="26"
                        ToolTip="Definir le debut du segment au playhead (I)"
                        Margin="0,0,4,2" />
                <Button Content="Out (O)"
                        Command="{Binding Edit.SetOutCommand, RelativeSource={RelativeSource AncestorType=controls:TimelineView}}"
                        Focusable="False"
                        Padding="8,3"
                        MinHeight="26"
                        ToolTip="Definir la fin du segment au playhead (O)"
                        Margin="0,0,4,2" />
                <Button Content="Supprimer marqueur"
                        Command="{Binding Edit.DeleteMarkerCommand, RelativeSource={RelativeSource AncestorType=controls:TimelineView}}"
                        Focusable="False"
                        Padding="8,3"
                        MinHeight="26"
                        ToolTip="Supprimer le marqueur selectionne (Suppr)"
                        Margin="0,0,4,2" />
                <Button Content="Activer / Desactiver (E)"
                        Command="{Binding Edit.ToggleEnabledCommand, RelativeSource={RelativeSource AncestorType=controls:TimelineView}}"
                        Focusable="False"
                        Padding="8,3"
                        MinHeight="26"
                        ToolTip="Inclure ou exclure le segment selectionne (E)"
                        Margin="0,0,8,2" />

                <Border Width="1"
                        Height="18"
                        Background="{StaticResource BorderBrush}"
                        Margin="0,0,8,2" />

                <Button Content="Annuler"
                        Command="{Binding Edit.UndoCommand, RelativeSource={RelativeSource AncestorType=controls:TimelineView}}"
                        Focusable="False"
                        Padding="8,3"
                        MinHeight="26"
                        ToolTip="Annuler la derniere modification (Ctrl+Z)"
                        Margin="0,0,4,2" />
                <Button Content="Retablir"
                        Command="{Binding Edit.RedoCommand, RelativeSource={RelativeSource AncestorType=controls:TimelineView}}"
                        Focusable="False"
                        Padding="8,3"
                        MinHeight="26"
                        ToolTip="Retablir la modification (Ctrl+Y ou Ctrl+Maj+Z)"
                        Margin="0,0,8,2" />

                <CheckBox Content="Aimanter aux keyframes"
                          IsChecked="{Binding Edit.SnapToKeyframes, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=controls:TimelineView}}"
                          Focusable="False"
                          ToolTip="Aimanter les coupes et marqueurs aux keyframes (maintenir Alt pour ignorer)"
                          VerticalAlignment="Center"
                          Margin="0,0,10,2" />

                <Border Width="1"
                        Height="18"
                        Background="{StaticResource BorderBrush}"
                        Margin="0,0,8,2" />

                <Button Content="Zoom -"
                        Command="{Binding Timeline.ZoomOutCommand, RelativeSource={RelativeSource AncestorType=controls:TimelineView}}"
                        Focusable="False"
                        Padding="8,3"
                        MinHeight="26"
                        ToolTip="Zoom arriere (Ctrl+-)"
                        Margin="0,0,4,2" />
                <Button Content="Zoom +"
                        Command="{Binding Timeline.ZoomInCommand, RelativeSource={RelativeSource AncestorType=controls:TimelineView}}"
                        Focusable="False"
                        Padding="8,3"
                        MinHeight="26"
                        ToolTip="Zoom avant (Ctrl++)"
                        Margin="0,0,4,2" />
                <Button Content="Ajuster"
                        Command="{Binding Timeline.FitToWindowCommand, RelativeSource={RelativeSource AncestorType=controls:TimelineView}}"
                        Focusable="False"
                        Padding="8,3"
                        MinHeight="26"
                        ToolTip="Ajuster a la fenetre (Ctrl+0)"
                        Margin="0,0,8,2" />

                <CheckBox Content="Suivre la lecture"
                          IsChecked="{Binding Timeline.FollowPlayback, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=controls:TimelineView}}"
                          Focusable="False"
                          VerticalAlignment="Center"
                          Margin="0,0,0,2" />
            </WrapPanel>
        </DockPanel>

        <!-- Controle de timeline personnalise -->
        <Border Grid.Row="1"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1,1,1,0"
                CornerRadius="3,3,0,0">
            <controls:TimelineControl x:Name="TimelineCanvas"
                                      Duration="{Binding Duration, RelativeSource={RelativeSource AncestorType=controls:TimelineView}}"
                                      Position="{Binding Position, RelativeSource={RelativeSource AncestorType=controls:TimelineView}}"
                                      IsPlaying="{Binding IsPlaying, RelativeSource={RelativeSource AncestorType=controls:TimelineView}}"
                                      PlaybackSpeed="{Binding PlaybackSpeed, RelativeSource={RelativeSource AncestorType=controls:TimelineView}}"
                                      Thumbnails="{Binding Thumbnails, RelativeSource={RelativeSource AncestorType=controls:TimelineView}}"
                                      PixelsPerSecond="{Binding Timeline.PixelsPerSecond, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=controls:TimelineView}}"
                                      ScrollOffsetSeconds="{Binding Timeline.ScrollOffsetSeconds, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=controls:TimelineView}}"
                                      IsFitToWindow="{Binding Timeline.IsFitToWindow, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=controls:TimelineView}}"
                                      FollowPlayback="{Binding Timeline.FollowPlayback, Mode=OneWay, RelativeSource={RelativeSource AncestorType=controls:TimelineView}}"
                                      Segments="{Binding Edit.Segments, Mode=OneWay, RelativeSource={RelativeSource AncestorType=controls:TimelineView}}"
                                      SelectedSegmentId="{Binding Edit.SelectedSegmentId, Mode=OneWay, RelativeSource={RelativeSource AncestorType=controls:TimelineView}}"
                                      SelectedMarkerIndex="{Binding Edit.SelectedMarkerIndex, Mode=OneWay, RelativeSource={RelativeSource AncestorType=controls:TimelineView}}"
                                      Keyframes="{Binding Edit.Keyframes, Mode=OneWay, RelativeSource={RelativeSource AncestorType=controls:TimelineView}}"
                                      SnapToKeyframes="{Binding Edit.SnapToKeyframes, Mode=OneWay, RelativeSource={RelativeSource AncestorType=controls:TimelineView}}"
                                      SeekRequested="OnTimelineSeekRequested"
                                      SeekCompleted="OnTimelineSeekCompleted"
                                      SegmentSelectionRequested="OnTimelineSegmentSelectionRequested"
                                      MarkerSelectionRequested="OnTimelineMarkerSelectionRequested"
                                      BoundaryDragPreview="OnTimelineBoundaryDragPreview"
                                      BoundaryDragCompleted="OnTimelineBoundaryDragCompleted"
                                      ViewportChanged="OnTimelineViewportChanged" />
        </Border>

        <!-- Barre de defilement horizontale synchronisee -->
        <ScrollBar x:Name="HorizontalScrollBar"
                   Grid.Row="2"
                   Orientation="Horizontal"
                   Minimum="0"
                   Maximum="0"
                   Value="0"
                   IsEnabled="False"
                   Focusable="False"
                   Scroll="OnScrollBarScroll" />
    </Grid>
</UserControl>
